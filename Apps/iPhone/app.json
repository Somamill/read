{
  "expo": {
    "name": "read.",
    "slug": "read-mobile",
    "version": "0.1.10",
    "scheme": "read-mobile",
    "orientation": "default",
    "icon": "./assets/read-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.somamill.read.mobile",
      "appleTeamId": "YJH8WWUVF3",
      "buildNumber": "8"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      "expo-asset",
      "expo-audio",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "updates": {
      "enabled": false
    }
  }
}
