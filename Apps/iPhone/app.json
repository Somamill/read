{
  "expo": {
    "name": "read.",
    "slug": "read-mobile",
    "version": "0.1.3",
    "scheme": "read-mobile",
    "orientation": "default",
    "icon": "./assets/read-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.somamill.read.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "144f24a8-e646-4acd-a3e3-4226538e4c89"
      }
    },
    "owner": "somamill",
    "updates": {
      "url": "https://u.expo.dev/144f24a8-e646-4acd-a3e3-4226538e4c89"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
