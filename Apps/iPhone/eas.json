{
  "cli": {
    "version": ">=27.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "store-preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "DOT_EDITION": "store"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "DOT_EDITION": "store"
      },
      "ios": {
        "credentialsSource": "local"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6834109889",
        "appleTeamId": "YJH8WWUVF3"
      }
    }
  }
}
